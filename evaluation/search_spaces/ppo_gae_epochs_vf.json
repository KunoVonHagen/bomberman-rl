{
  "name": "ppo_gae_epochs_vf",
  "agent": "ppo_agent",
  "train": [
    "python",
    "-m",
    "agent_code.ppo_agent.train",
    "--device",
    "auto",
    "--n-envs",
    "64",
    "--n-shards",
    "4",
    "--no-schedule"
  ],
  "override_style": "set",
  "fixed": {
    "total_timesteps": 1000000,
    "save_every_timesteps": 1000000,
    "eval_every_save": false,
    "ppo.n_steps": 256,
    "self_play.enabled": false,
    "self_play.static_opponents": "agent_code.rule_based_agent.callbacks,agent_code.rule_based_agent.callbacks,agent_code.rule_based_agent.callbacks"
  },
  "parameters": [
    {
      "name": "ppo.gae_lambda",
      "values": [0.9, 0.95, 0.97, 0.99]
    },
    {
      "name": "ppo.n_epochs",
      "values": [2, 4, 8]
    },
    {
      "name": "ppo.vf_coef",
      "values": [0.3, 0.7, 1.0]
    }
  ],
  "validation": {
    "matchups": [
      "task2-classic-solo",
      "task4-rule-based-x3"
    ],
    "n_rounds": 120,
    "seed": 0,
    "workers": 8,
    "criterion": "score"
  }
}