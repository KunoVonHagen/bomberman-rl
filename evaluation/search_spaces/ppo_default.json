{
  "name": "ppo_default",
  "agent": "ppo_agent",
  "train": [
    "python",
    "-m",
    "agent_code.ppo_agent.train",
    "--device",
    "auto",
    "--n-envs",
    "64",
    "--n-shards",
    "4",
    "--no-schedule"
  ],
  "override_style": "set",
  "fixed": {
    "total_timesteps": 1000000,
    "save_every_timesteps": 1000000,
    "eval_every_save": false,
    "ppo.n_steps": 256,
    "self_play.enabled": false,
    "self_play.static_opponents": "agent_code.rule_based_agent.callbacks,agent_code.rule_based_agent.callbacks,agent_code.rule_based_agent.callbacks"
  },
  "parameters": [
    {
      "name": "ppo.learning_rate",
      "values": [
        3e-05,
        0.0001,
        0.0003,
        0.001
      ],
      "log": true
    },
    {
      "name": "ppo.gamma",
      "values": [
        0.95,
        0.98,
        0.99,
        0.995
      ]
    },
    {
      "name": "ppo.ent_coef",
      "values": [
        0.003,
        0.01,
        0.03,
        0.1
      ],
      "log": true
    },
    {
      "name": "ppo.clip_range",
      "values": [
        0.1,
        0.2,
        0.3
      ]
    }
  ],
  "validation": {
    "matchups": [
      "task2-classic-solo",
      "task4-rule-based-x3"
    ],
    "n_rounds": 120,
    "seed": 0,
    "workers": 8,
    "criterion": "score"
  }
}
