{
  "name": "dqn_shaping",
  "agent": "dqn_agent",
  "train": [
    "python",
    "-m",
    "agent_code.dqn_agent.train",
    "--device",
    "auto",
    "--n-envs",
    "64",
    "--n-shards",
    "4",
    "--no-schedule"
