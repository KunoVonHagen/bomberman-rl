{
  "name": "dqn_default",
  "agent": "dqn_agent",
  "train": [
    "python",
    "-m",
    "agent_code.dqn_agent.train",
    "--device",
    "auto",
    "--n-envs",
    "64",
    "--n-shards",
    "4",
    "--no-schedule"
  ],
  "override_style": "set",
  "fixed": {
    "total_timesteps": 1000000,
    "save_every_timesteps": 1000000,
    "save_replay_buffer_transitions": 0,
    "dqn.learning_starts": 20000,
    "self_play.enabled": false,
    "self_play.static_opponents": "agent_code.rule_based_agent.callbacks,agent_code.rule_based_agent.callbacks,agent_code.rule_based_agent.callbacks"
  },
  "parameters": [
    {
      "name": "dqn.learning_rate",
      "values": [
        3e-05,
        0.0001,
        0.0003,
        0.001,
        0.003
      ],
      "log": true
    },
    {
      "name": "dqn.gamma",
      "values": [
        0.9,
        0.95,
        0.98,
        0.99,
        0.995
      ]
    },
    {
      "name": "dqn.target_update_interval",
      "values": [
        1000,
        3000,
        10000,
        30000
      ],
      "log": true
    },
    {
      "name": "dqn.exploration_fraction",
      "values": [
        0.05,
        0.1,
        0.2,
        0.4
      ],
      "log": true
    }
  ],
  "validation": {
    "matchups": [
      "task2-classic-solo",
      "task4-rule-based-x3"
    ],
    "n_rounds": 20,
    "seed": 0,
    "workers": 4,
    "criterion": "score"
  }
}
